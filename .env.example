# RestaurantOS runs fully locally with a SQLite database file (default: local.db).
# You normally do NOT need this file at all — the default works out of the box.
# Only set DATABASE_URL if you want a custom SQLite path:
# DATABASE_URL=file:local.db
# Note: postgres:// URLs are not used by RestaurantOS and will be ignored
# (it always falls back to the local database file).
